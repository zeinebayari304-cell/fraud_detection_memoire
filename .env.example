# Copiez ce fichier en .env puis remplissez les valeurs. Ne versionnez jamais .env.

# Port de l'application sur votre machine : http://localhost:8080
APP_PORT=8080

# Base PostgreSQL (mot de passe : lettres et chiffres uniquement, il est placé dans une URL)
POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=

# Secret de signature des sessions (JWT) : une longue chaîne aléatoire.
# Exemple pour en générer un : python -c "import secrets; print(secrets.token_urlsafe(48))"
FRAUD_JWT_SECRET=
FRAUD_JWT_EXPIRE_MINUTES=120

# Seuil de décision (0,5 = règle native des modèles, reproduit le mémoire)
FRAUD_THRESHOLD=0.5

# Premier administrateur, créé au premier démarrage s'il n'en existe aucun.
# Mot de passe : 8 caractères min., une majuscule, une minuscule, un chiffre.
FRAUD_ADMIN_USERNAME=
FRAUD_ADMIN_EMAIL=
FRAUD_ADMIN_PASSWORD=
