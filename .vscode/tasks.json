{
  "version": "2.0.0",
  "inputs": [
    { "id": "adminUser", "type": "promptString", "description": "Nom d'utilisateur de l'administrateur" },
    { "id": "adminEmail", "type": "promptString", "description": "E-mail de l'administrateur" }
  ],
  "tasks": [
    {
      "label": "Backend : installer les dépendances (une seule fois)",
      "type": "shell",
      "command": "py -m venv backend\\.venv; backend\\.venv\\Scripts\\python.exe -m pip install -r backend\\requirements-dev.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Frontend : installer les dépendances (une seule fois)",
      "type": "shell",
      "command": "npm ci --legacy-peer-deps",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Backend : créer un administrateur",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe manage.py create-user --role admin --username ${input:adminUser} --email ${input:adminEmail}",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Backend : lancer l'API (port 8000)",
      "type": "shell",
      "command": "if (Test-Path ..\\.env) { ${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000 --env-file ..\\.env } else { ${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000 }",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Will watch for changes",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": { "panel": "dedicated", "group": "fraud-app" }
    },
    {
      "label": "Frontend : lancer l'interface (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": { "panel": "dedicated", "group": "fraud-app" }
    },
    {
      "label": "Lancer l'application (API + interface)",
      "dependsOn": [
        "Backend : lancer l'API (port 8000)",
        "Frontend : lancer l'interface (port 5173)"
      ],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Tests : backend (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests : frontend (vitest)",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Docker : démarrer l'application (http://localhost:8080)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker : arrêter l'application",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
